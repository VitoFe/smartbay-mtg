# Copy to .env (git-ignored) and fill in. src/settings.py reads it; variables already set in the
# environment take precedence. Never commit .env, and never paste its values into an issue or log.

# --- Data ----------------------------------------------------------------------------------------
# Folder holding raw/, processed/, external/ ... (README, "Data"). Then run:
#   python scripts/data_setup.py link
#   python scripts/data_setup.py check
SMARTBAY_DATA_DIR=

# --- Compute host for remote campaigns (scripts/scientific_campaign.py) -------------------------
SMARTBAY_SSH_HOST=
SMARTBAY_SSH_PORT=22
SMARTBAY_SSH_USER=
# Prefer a key file; a password is used only if no key file is given.
SMARTBAY_SSH_KEY_FILE=
SMARTBAY_SSH_PASSWORD=
# Project directory on the host (its .venv holds the remote environment)
SMARTBAY_REMOTE_DIR=

# --- Copernicus Marine (scripts/download_copernicus.py; read by the toolbox itself) -------------
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
